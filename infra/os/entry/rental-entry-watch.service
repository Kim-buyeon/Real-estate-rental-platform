[Unit]
# 입구 감시 — 대기 노드가 상대 입구를 보고, 응답하지 않으면 입구 고정 IP(Elastic IP)를 자기에게 옮긴다(INF-01 입구 이중화, #404).
# **두 앱 노드(APP-01 · APP-02) 모두에 둔다.** 고정 IP 를 가진 쪽은 아무것도 하지 않는다 — 판정 · 값은 entry-watch.sh 머리 주석.
# 정기 작업(timer)이 아니라 늘 도는 서비스다 — 몇 초 단위로 봐야 하고, 실패 기록은 저널과 지표(entry.prom)에 남는다.
#
# 설치(infra/tls/rental-tls.service 와 같은 방식 — 체크아웃은 deploy 홈):
#   sudo install -D -o root -g root -m 755 /home/deploy/rental/infra/os/entry/entry-watch.sh /opt/rental/infra/os/entry/entry-watch.sh   스크립트가 바뀌면 다시
#   /etc/rental/entry.env(root 644) — 키는 entry-watch.sh 머리 「설정」, 노드별 값은 운영 절차서(입구 이중화 반영). 시크릿이 없다.
#     infra/tls/rental-tls.service 도 같은 파일을 읽는다(ENTRY_IP · PEER_SSH)
#   systemd-analyze verify /home/deploy/rental/infra/os/entry/rental-entry-watch.service
#   sudo cp /home/deploy/rental/infra/os/entry/rental-entry-watch.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo ONCE=1 DRY_RUN=1 /opt/rental/infra/os/entry/entry-watch.sh   한 바퀴 판정만 — 저널 대신 화면에
#   sudo systemctl enable --now rental-entry-watch.service
Description=Rental entry watch (move entry Elastic IP to this node when the peer entry is down; no failback)
# AWS API(고정 IP 옮기기)와 IMDS 가 필요하다. 상대 · 자기 입구의 응답은 스크립트가 바퀴마다 본다 — 부팅 직후에는 BOOT_GRACE 동안
# 옮기지 않고, 자기 Nginx 가 아직 뜨지 않았으면 「자기 입구도 응답하지 않는다」로 옮기지 않는다(판정 (1)).
# After=docker.service — 기동 순서가 아니라 **끌 때의 순서** 때문이다. systemd 는 끌 때 거꾸로 멈추므로 이 감시가 docker(Nginx)보다
# 먼저 멈춘다. 두 노드를 함께 끌 때(운영 절차서 9.1) 상대 Nginx 가 먼저 내려가는 것을 보고 고정 IP 를 가져가는 일을 줄인다 —
# 막지는 못한다(상대가 먼저 꺼지기 시작하면). 켠 뒤 고정 IP 가 어느 노드에 있는지 본다(운영 절차서 9.6).
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# root 로 돈다 — rental-tls.service 를 부르고(systemctl) 지표 디렉터리(backup 소유 755)에 쓴다. AWS 권한은 인스턴스 역할이 준다
# (고정 IP 하나에 대한 AssociateAddress · DescribeAddresses 만 — infra/aws/entry-iam.sh)
EnvironmentFile=/etc/rental/entry.env
ExecStart=/opt/rental/infra/os/entry/entry-watch.sh
# 스크립트가 죽어도(set -e 를 쓰지 않지만 셸 자체 오류 등) 감시가 멈춘 채 남지 않게 한다
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rental-entry-watch
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
