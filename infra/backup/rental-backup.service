[Unit]
# 논리 백업 — 서버 운영 기반 설계서 5.1 · 7.2(작업 목록), 운영 절차서 5장 · 9.3.
# timer 가 부른다. 직접 한 번 돌릴 때는 systemctl start rental-backup.service
Description=Rental logical backup (pg_dump -Fc, encrypted)
After=network-online.target
Wants=network-online.target
# 목적지가 NAS(NFS)가 되면 그 마운트를 RequiresMountsFor= 로 더한다 — 공유 경로가 7주차에 정해지므로 지금은 두지 않는다

[Service]
Type=oneshot
# 백업 디렉터리를 소유하는 역할 계정. 로그인 불가이며 UID · GID 는 전 노드에서 2001 / 2001 로 고정한다(설계서 6.2) —
# 시스템 계정 자동 할당(201 ~ 999)과 사람 계정(1000 부터) 어디에도 닿지 않는 값이라 NFS 권한이 노드마다 어긋나지 않는다
User=backup
Group=backup

# 접속 정보 · 목적지 · 보존 · 암호화 도구는 이 파일에 적지 않는다. 노드의 설정 파일(0600, backup 소유)에서 읽는다.
# 비밀번호를 Environment= 로 적으면 systemctl show 로 보인다 — EnvironmentFile 로만 넣는다.
# ExecStart 는 체크아웃이 아니라 설치한 사본(root 소유 755)을 가리킨다 — 체크아웃은 ec2-user 홈 아래라 700 이어서
# backup 계정이 읽지 못하고, 풀면 .env 가 든 체크아웃을 여는 셈이다. 그래서 스크립트가 바뀌면 다시 설치한다(운영 절차서 9.3).
EnvironmentFile=/etc/rental/backup.env
ExecStart=/opt/rental/infra/backup/pg-dump.sh

# 실행 시간 상한 — 설계서 5.3 이 NAS 를 쓰는 정기 작업에 상한을 요구한다. hard 마운트에서 NAS 가 멈추면 작업이 끝나지
# 않고 남아 저널에 실패조차 남지 않는다. **값은 미확정**(설계서 10장 「NAS 작업 시간 상한 — NAS 목적지로 바꾼 뒤 첫 실행
# 소요를 본 뒤」) — 아래는 잠정값이다. 첫 실행은 로컬 목적지로 이미 돌았지만(운영 절차서 9.3) 상한은 NAS 정지에 대비한
# 값이라 로컬 실측은 그 경우를 대표하지 않는다. NAS 목적지로 바꾼 뒤 첫 실행 소요를 보고 확정한다.
TimeoutStartSec=30min

# 모니터링이 없어 저널이 유일한 확인 수단이다(설계서 7.1). 출력을 그대로 journald 에 남긴다
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rental-backup

NoNewPrivileges=true
PrivateTmp=true

# 실패해도 같은 날 다시 시도하지 않는다. 원인이 남아 있으면 반복해도 같은 실패가 쌓일 뿐이고,
# 다음 실행은 다음 날 timer 가 만든다. 실패는 journalctl -u rental-backup 으로 본다
Restart=no
