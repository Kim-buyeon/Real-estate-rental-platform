      },
      "annotations": {
        "summary": "{{ $labels.node }} 가용 메모리 {{ humanize1024 $values.A.Value }}B — 60 MiB 아래로 2분",
        "description": "노드의 가용 메모리가 60 MiB 아래에서 2분 넘게 머문다. 부하 시험(#390)에서 APP-01 이 무응답 · 재부팅된 범위(가용 58 ~ 73 MiB)다 — 곧 OOM 강제 종료나 노드 멈춤이 온다. 멈추면 EC2 자동 복구 경보가 재부팅하고 수집 끊김이 뒤따른다.",
        "action": "곧바로 {{ $labels.node }} 에 접속해 free -m · docker stats --no-stream 으로 가장 큰 소비자를 찾는다. OOM 강제 종료 경보가 함께 왔는지 본다. 접속이 안 되면 EC2 자동 복구 경보(재부팅)가 도는지 본다 — 운영 절차서 2장 「노드 자동 복구」 · 경보별 조치."
      }
    },
    {
      "uid": "rentaloomkill01",
      "orgID": 1,
      "folderUID": "fq8pjr",
      "ruleGroup": "rental-service",
      "title": "OOM 강제 종료",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "editorMode": "code",
            "expr": "increase(node_vmstat_oom_kill{job=\"node\"}[5m])",
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "queryType": "expression",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
