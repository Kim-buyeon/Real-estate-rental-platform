            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"app\",uri!~\"/actuator.*|/api/notifications/stream|UNKNOWN\",status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"app\",uri!~\"/actuator.*|/api/notifications/stream|UNKNOWN\"}[5m]))",
