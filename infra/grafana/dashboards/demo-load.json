    {
      "id": 21,
      "type": "stat",
      "title": "서비스 상태",
      "description": "입구 Nginx · 앱 슬롯 · DB primary · Redis 가 모두 살아 있으면 정상(운영 요약 「서비스」와 같은 식).",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 4,
        "h": 4
      },
      "interval": "15s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "(max(up{job=\"nginx\"}) or vector(0)) * (clamp_max(sum(up{job=\"app\"}), 1) or vector(0)) * (max(pg_up and on (node) pg_replication_is_replica == 0) or vector(0)) *(max(redis_up) or vector(0))",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "정상",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "장애",
                  "color": "red",
                  "index": 1
