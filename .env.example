# 환경 변수 목록. 이름만 두고 값은 넣지 않는다.
# 실제 값은 같은 위치의 .env 에 넣는다 — .env 는 커밋하지 않는다 (.gitignore).
# 서버에서는 docker compose 가 이 파일과 같은 이름의 .env 를 읽어 컨테이너에 주입한다 — 운영 절차서 3장.
# 새 변수를 추가하면 여기와 그 변수를 정한 문서를 같은 커밋에서 고친다. doc-check 가 대조한다.

# ── 애플리케이션 · 데이터베이스 ──────────────────────────────────────────
# postgres 이미지가 읽는 이름을 그대로 쓴다. 앱은 application.yml 에서 ${POSTGRES_USER} 처럼 같은 값을 읽는다.
DB_HOST=
DB_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 스트리밍 복제 계정 — primary → standby (INF-03). 초기화 스크립트가 만든다.
POSTGRES_REPLICATION_USER=
POSTGRES_REPLICATION_PASSWORD=

# ── 애플리케이션 · Redis ────────────────────────────────────────────────
# 토큰 · 캐시 · SSE 팬아웃 · 배치 분산 락. 동일 노드 루프백만 허용 — 시스템 구성서 4장.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ── 애플리케이션 · 인증 ────────────────────────────────────────────────
# 액세스 · 리프레시 토큰 서명 키. 알고리즘은 미확정 — 비대칭으로 정하면 키 쌍 변수로 바뀐다.
JWT_SECRET=

# ── 애플리케이션 · 외부 API 키 ─────────────────────────────────────────
# 이름은 데이터 적재 문서 1.3 표가 정본. 등기부등본은 개방 API 가 없어 Mock 만 쓰므로 변수가 없다.
# 공공데이터포털 — 전월세 실거래가 · 건축물대장. 키는 하나, 활용 신청은 서비스별로 각각
DATA_GO_KR_API_KEY=
# 도로명주소 — 주소 정규화
ADDRESS_API_KEY=
# 카카오 로컬 — 좌표. 서버 전용, 프론트에서 쓰지 않는다
KAKAO_REST_API_KEY=
# 한국은행 ECOS — 기준금리 · 시장금리
ECOS_API_KEY=
# 금융상품 통합비교공시 — 대출 상품 · 금리
FINLIFE_API_KEY=

# ── 프론트 ──────────────────────────────────────────────────────────────
# 카카오맵 JavaScript 키. 번들에 노출되므로 비밀이 아니다 — 보호 수단은 Kakao 콘솔의 도메인 등록.
# Vite 는 frontend/ 의 .env 를 읽는다. 루트 .env 를 쓰려면 vite.config 의 envDir 를 루트로 지정한다.
VITE_KAKAO_MAP_KEY=

# ── 관측 스택 ────────────────────────────────────────────────────────────
# Grafana 기본 인증 — Nginx 경유로만 접근. 이미지가 읽는 이름 그대로.
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

# Slack Incoming Webhook. URL 하나가 채널 하나에 묶이므로 채널마다 따로 발급한다 — 관측 설계서 5장.
# Alertmanager 설정 파일은 환경 변수를 치환하지 않는다. 기동 시 envsubst 로 넣는다.
# #alert-critical
SLACK_WEBHOOK_CRITICAL=
# #alert-warning
SLACK_WEBHOOK_WARNING=
# 세 번째 웹훅(HetrixTools → Slack)은 HetrixTools 콘솔에 등록한다. 서버가 쓰지 않으므로 여기 두지 않는다.

# critical 이메일 발송 수단은 미확정 — SMTP 계정인지 외부 발송 서비스인지 셋업 때 정한다 (관측 설계서 5장).
# 확정되면 여기에 변수를 추가한다.

# ── 백업 · WAL 아카이브 (INF-04) ────────────────────────────────────────
# S3 호환 오브젝트 스토리지. 온프레미스면 MinIO — 엔드포인트만 바뀐다.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 백업 파일 암호화 키. 대칭이면 이 값이 곧 복호화 키다 — 서버 밖에 별도 보관한다 (기술 스택 정의서: 복호화 키 분리 보관).
BACKUP_ENCRYPTION_KEY=

# ── 도메인 · TLS ─────────────────────────────────────────────────────────
# Nginx server_name 과 Let's Encrypt 발급에 쓴다.
DOMAIN=
LETSENCRYPT_EMAIL=

# ── 여기 두지 않는 것 ────────────────────────────────────────────────────
# GITHUB_TOKEN        — GitHub Actions 가 실행마다 발급한다. 컨테이너 레지스트리 인증은 이것으로 끝난다.
# 부하 시험 토큰 풀    — chaos-harness/load/tokens.json. 스크립트가 생성하며 커밋하지 않는다.
# 토큰 만료 시간 · 포트 · 슬롯 번호 — 비밀도 환경 차이도 아니다. application.yml 과 compose 파일이 갖는다.