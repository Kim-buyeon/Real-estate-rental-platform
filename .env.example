# 환경 변수 목록. 이름만 두고 값은 넣지 않는다.
# 실제 값은 같은 위치의 .env 에 넣는다 — .env 는 커밋하지 않는다 (.gitignore).
# 서버에서는 docker compose 가 이 파일과 같은 이름의 .env 를 읽어 컨테이너에 주입한다 — 운영 절차서 3장.
# 새 변수를 추가하면 여기와 그 변수를 정한 문서를 같은 커밋에서 고친다. doc-check 가 대조한다.

# ── 애플리케이션 · 데이터베이스 ──────────────────────────────────────────
# postgres 이미지가 읽는 이름을 그대로 쓴다. 앱은 application.yml 에서 ${POSTGRES_USER} 처럼 같은 값을 읽는다.
# DB_HOST — 단일 노드 운영(infra/.env)에서는 비워 둔다(운영 Compose 가 postgres 로 채운다) · 페일오버 때만 postgres-standby 로 바꾼다(운영 절차서 6.1).
# 3노드 APP-01 은 DB-01 사설 IP 를 넣는다(시스템 구성서 4장).
DB_HOST=
DB_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 스트리밍 복제 계정 — primary → standby (INF-03). 역할(REPLICATION LOGIN, 최고 권한 아님)은 노드 적용 절차가 primary 에서 만든다.
# POSTGRES_REPLICATION_USER=replicator — infra/postgres/pg_hba.conf 의 복제 줄과 같은 이름이어야 한다(그 파일에는 변수를 쓸 수 없다).
# 두 값은 postgres · postgres-standby 에 넘어간다(postgres 는 페일백 때 standby 에서 받는 데 쓴다). 비밀번호는 기동 때 컨테이너 메모리(tmpfs)의 비밀번호 파일로 옮겨지고 데이터 디렉터리에는 남지 않는다.
POSTGRES_REPLICATION_USER=
POSTGRES_REPLICATION_PASSWORD=
# PG_BOOTSTRAP_FROM — postgres 가 빈 데이터 디렉터리일 때 받아 올 곳. 평시에는 비워 둔다(비면 initdb 또는 기존 데이터로 기동).
# 페일백 때만 postgres-standby 로 채우고, 승격 뒤 다시 비운다(운영 절차서 6.2).
PG_BOOTSTRAP_FROM=

# ── 운영 · 노드 구성 (INF-03 3노드) ─────────────────────────────────────
# 운영 Compose(infra/docker-compose.yml)만 읽는다. 로컬 구성에는 쓰이지 않는다.
# COMPOSE_PROFILES — 이 노드에 띄울 프로필. 단일 노드는 app,db,standby, 3노드는 APP-01 app · DB-01 db · DB-02 standby.
# 비우면 아무 서비스도 뜨지 않는다.
COMPOSE_PROFILES=
# PG_PUBLISH_ADDR — postgres 의 5432 게시 주소. 단일 노드는 비워 둔다(루프백). DB-01 은 자기 사설 IP 하나(0.0.0.0 금지).
PG_PUBLISH_ADDR=
# PG_STANDBY_FROM — standby 가 빈 데이터 디렉터리일 때 받아 올 primary. 단일 노드는 비워 둔다(postgres). DB-02 는 DB-01 사설 IP.
PG_STANDBY_FROM=
# PG_STANDBY_PUBLISH_ADDR · PG_STANDBY_PUBLISH_PORT — 승격 뒤 앱이 붙는 standby 게시 자리.
# 단일 노드는 비워 둔다(루프백 5433). DB-02 는 자기 사설 IP 와 5432.
PG_STANDBY_PUBLISH_ADDR=
PG_STANDBY_PUBLISH_PORT=

# ── 애플리케이션 · Redis ────────────────────────────────────────────────
# 토큰 · 캐시 · SSE 팬아웃 · 배치 분산 락. 동일 노드 루프백만 허용 — 시스템 구성서 4장.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ── 애플리케이션 · 인증 ────────────────────────────────────────────────
# 액세스 · 리프레시 토큰 서명 키. 알고리즘은 미확정 — 비대칭으로 정하면 키 쌍 변수로 바뀐다.
JWT_SECRET=

# ── 애플리케이션 · 메일 (USER-06 비밀번호 재설정) ──────────────────────
# external.mail.mode=real 일 때만 쓰인다. 기본 mock 은 보내지 않고 링크를 로그로 남기므로 비워 둬도 돈다.
# 운영은 Gmail SMTP — 기술 스택 정의서 2장. 호스트 · 포트 줄이 없으면 smtp.gmail.com · 587(STARTTLS)이다(빈 값으로 두면 빈 값이 들어간다).
MAIL_HOST=
MAIL_PORT=
# 보내는 Gmail 계정 주소.
MAIL_USERNAME=
# Gmail 계정 비밀번호가 아니라 「앱 비밀번호」(16자)다. Google 계정 > 보안 > 2단계 인증을 켠 뒤 앱 비밀번호에서 발급한다.
# 2단계 인증 없이는 발급 메뉴가 없고, 계정 비밀번호로는 SMTP 로그인이 거절된다.
MAIL_PASSWORD=
# 보낸 사람 주소. Gmail 은 MAIL_USERNAME 또는 그 계정에 등록된 별칭이어야 한다 — 아니면 로그인 계정으로 바뀌어 나간다.
MAIL_FROM=
# 메일 링크의 화면 기준 주소(끝의 / 없이). 링크는 <이 값>/password-reset/confirm?token=<토큰>. 줄이 없으면 http://localhost:5173.
APP_BASE_URL=

# ── 애플리케이션 · 외부 API 키 ─────────────────────────────────────────
# 이름은 데이터 적재 문서 1.3 표가 정본. 등기부등본은 개방 API 가 없어 Mock 만 쓰므로 변수가 없다.
# 공공데이터포털 — 전월세 실거래가 · 건축물대장. 키는 하나, 활용 신청은 서비스별로 각각
DATA_GO_KR_API_KEY=
# 도로명주소 — 주소 정규화
ADDRESS_API_KEY=
# 카카오 로컬 — 좌표. 서버 전용, 프론트에서 쓰지 않는다
KAKAO_REST_API_KEY=
# 한국은행 ECOS — 기준금리 · 시장금리
ECOS_API_KEY=
# 금융상품 통합비교공시 — 대출 상품 · 금리
FINLIFE_API_KEY=

# ── 프론트 ──────────────────────────────────────────────────────────────
# 카카오맵 JavaScript 키. 번들에 노출되므로 비밀이 아니다 — 보호 수단은 Kakao 콘솔의 도메인 등록.
# Vite 는 frontend/ 의 .env 를 읽는다. 루트 .env 를 쓰려면 vite.config 의 envDir 를 루트로 지정한다.
VITE_KAKAO_MAP_KEY=

# ── 관측 · 전송 (INF-05) ─────────────────────────────────────────────────
# 노드에는 수집기만 두고 지표 · 로그를 Grafana Cloud 로 보낸다. 값은 Grafana Cloud 스택의 연결 정보에서 옮긴다.
# 수집기(prom-agent · vector)에는 .env 전체가 아니라 이 변수만 넘긴다 — infra/docker-compose.yml.
# 하나라도 비어 있으면 prom-agent 는 기동에 실패한다(빈 자격 증명으로 돌지 않는다).
# 지표 — Prometheus remote_write 주소(…/api/prom/push), 인스턴스 ID(숫자), 토큰(쓰기 권한 액세스 정책)
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_PROM_TOKEN=
# 로그 — Loki 주소(호스트까지만. Vector 가 /loki/api/v1/push 를 붙인다), 사용자 ID(숫자), 토큰
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOKI_TOKEN=

# postgres exporter 가 붙는 전용 역할 — pg_monitor 멤버, 최고 권한 아님. 앱 소유자 역할(POSTGRES_USER)을 쓰지 않는다.
# 역할은 노드 적용 때 만든다(이름은 rental_monitor).
POSTGRES_MONITOR_USER=
POSTGRES_MONITOR_PASSWORD=

# ── 관측 · 자체 호스팅으로 되돌릴 때 ────────────────────────────────────
# 지금은 쓰지 않는다 — 저장 · 시각화 · 알림을 노드 밖(Grafana Cloud)으로 보냈다(2026-09-23 결정).
# Grafana · Alertmanager 를 다시 노드에 올리면 이 변수들이 쓰인다. 그때까지 비워 둔다.
# Grafana 기본 인증 — Nginx 경유로만 접근. 이미지가 읽는 이름 그대로.
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

# Slack Incoming Webhook. URL 하나가 채널 하나에 묶이므로 채널마다 따로 발급한다 — 관측 설계서 5장.
# Alertmanager 설정 파일은 환경 변수를 치환하지 않는다. 기동 시 envsubst 로 넣는다.
# #alert-critical
SLACK_WEBHOOK_CRITICAL=
# #alert-warning
SLACK_WEBHOOK_WARNING=
# 세 번째 웹훅(HetrixTools → Slack)은 HetrixTools 콘솔에 등록한다. 서버가 쓰지 않으므로 여기 두지 않는다.

# critical 이메일 발송 수단은 미확정 — SMTP 계정인지 외부 발송 서비스인지 셋업 때 정한다 (관측 설계서 5장).
# 확정되면 여기에 변수를 추가한다.

# ── 백업 · WAL 아카이브 (INF-04) ────────────────────────────────────────
# S3 호환 오브젝트 스토리지. 온프레미스면 MinIO — 엔드포인트만 바뀐다.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 백업 파일 암호화 키. 대칭이면 이 값이 곧 복호화 키다 — 서버 밖에 별도 보관한다 (기술 스택 정의서: 복호화 키 분리 보관).
BACKUP_ENCRYPTION_KEY=

# ── 도메인 · TLS ─────────────────────────────────────────────────────────
# Nginx server_name 과 Let's Encrypt 발급에 쓴다.
DOMAIN=
LETSENCRYPT_EMAIL=

# ── 여기 두지 않는 것 ────────────────────────────────────────────────────
# GITHUB_TOKEN        — GitHub Actions 가 실행마다 발급한다. 컨테이너 레지스트리 인증은 이것으로 끝난다.
# 부하 시험 토큰 풀    — chaos-harness/load/tokens.json. 스크립트가 생성하며 커밋하지 않는다.
# 토큰 만료 시간 · 포트 · 슬롯 번호 — 비밀도 환경 차이도 아니다. application.yml 과 compose 파일이 갖는다.