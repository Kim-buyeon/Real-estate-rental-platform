# 실제 환경 변수 값. 이름만 담은 .env.example 은 커밋한다.
.env

# npm 설치 산출물. frontend/ 는 자기 .gitignore 로 같은 것을 무시한다.
# 루트에서 npm 을 실행할 일은 없으나, 실수로 실행해도 추적되지 않게 둔다.
node_modules
dist

# 에이전트 작업 트리 — 로컬 전용
.claude/worktrees/

# 디자인 추출 작업 폴더 — 참고 사이트 스크린샷은 저작물이므로 커밋하지 않는다
artifacts/
picture/

# JVM 크래시 로그
hs_err_pid*.log
replay_pid*.log

# 점검 모드 표시 파일 — 서버 상태이지 구성이 아니다(infra/maintenance.sh)
infra/nginx/maintenance/on

# 배포용 로컬 메모와 SSH 키 — 계정 비밀번호 · 앱 비밀번호 · 프라이빗 키가 들어 있다
aws.txt
*.pem

# 부하 시험 — 토큰 풀(JWT)과 실행 결과는 커밋하지 않는다(INF-06)
chaos-harness/load/tokens*.json
chaos-harness/load/results/
