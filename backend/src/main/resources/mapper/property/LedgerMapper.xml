<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  건축물대장 조회. API 명세서(매물) 1.8.

  응답 필드와 컬럼 이름이 다른 것은 V1 컬럼을 그대로 두고 별칭으로 맞춘다.
    mainPurpose ← building_purpose, violationBuilding ← violation_yn, collectedAt ← updated_at
  isResidential 은 컬럼이 아니다. 응답의 정적 팩토리가 주용도에서 만든다.
  updated_at 은 서울 벽시계 시각으로 저장되어 있어 AT TIME ZONE 으로 시각(timestamptz)을 확정해 넘긴다.

  매물에서 출발해 대장을 LEFT JOIN 한다. 뗄 대장이 없는 매물(조회 키 없음 · 필지에 맞는 표제부 없음)은 대장을 저장하지
  않으므로, 행이 없으면 「매물 없음」, 행은 있는데 대장 컬럼이 전부 NULL 이면 「대장 없음」이다.
-->
<mapper namespace="com.duri.rentalplatform.domain.property.mapper.LedgerMapper">

    <select id="selectLedger" resultType="com.duri.rentalplatform.domain.property.vo.LedgerRow">
        SELECT p.property_id,
               bl.building_purpose AS main_purpose,
               bl.violation_yn AS violation_building,
               bl.total_floor_area,
               bl.exclusive_area,
               bl.approval_date,
               bl.data_source,
               bl.updated_at AT TIME ZONE 'Asia/Seoul' AS collected_at
          FROM property p
          LEFT JOIN building_ledger bl ON bl.property_id = p.property_id
         WHERE p.property_id = #{propertyId}
    </select>

    <!--
      Mock 대장 교체 배치의 대상. 대장 행에서 출발하므로 매물마다 한 번만 나온다(property_id UNIQUE). 매물 식별자
      오름차순이라 식별자 자체가 커서이고 동률이 없다 — 배치가 앞 페이지의 행을 교체 · 삭제해도 커서가 흔들리지 않는다.
      관심 매물 조건은 EXISTS 로 두어 여러 사용자가 등록한 매물이 중복되지 않게 한다(idx_wishlist_property, V13).
      정렬 · 커서는 uq_building_ledger_property_id(V5) 순서다. data_source 인덱스는 없다 — 실행 계획은 미검증.
    -->
    <select id="selectPropertyIdsByLedgerSource" resultType="java.lang.Long">
        SELECT bl.property_id
          FROM building_ledger bl
        <where>
            bl.data_source = #{dataSource}
            <if test="wishlistedOnly">
                AND EXISTS (SELECT 1 FROM wishlist w WHERE w.property_id = bl.property_id)
            </if>
            <if test="lastPropertyId != null">
                AND bl.property_id &gt; #{lastPropertyId}
            </if>
        </where>
         ORDER BY bl.property_id
         LIMIT #{limit}
    </select>
</mapper>
