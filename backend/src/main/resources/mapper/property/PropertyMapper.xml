<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  매물 조회. API 명세서(매물) 1.4 ~ 1.7 · 1.12.

  위험 정보는 최신 분석(is_latest = TRUE)을 LEFT JOIN 한다. 분석 이력이 없는 매물도 조회되며
  risk_grade · lease_ratio 가 NULL 로 나온다.
  계약 유형 · 매물 유형은 property_code.code_value 가 열거 상수명과 같다.
  registered_at 은 서울 벽시계 시각으로 저장되어 있어 AT TIME ZONE 으로 시각(timestamptz)을 확정해 넘긴다.
-->
<mapper namespace="com.duri.rentalplatform.domain.property.mapper.PropertyMapper">

    <!--
      FROM 조각은 조회가 쓰는 코드 조인만 붙이도록 셋으로 나눈다. PostgreSQL 은 INNER JOIN 을 스스로 떼지 못해, 코드 값을
      고르지도 거르지도 않는 조회도 조인 비용을 낸다. contract_type_code_id · property_type_code_id 는 property_code 를 가리키는
      NOT NULL 외래 키(V1)라 조인을 떼도 행이 바뀌지 않는다. 코드 필터는 아래 filter 가 식별자 비교로 건다.
      운영 측정(298k 매물, 5회 중앙값, #326): 자치구 집계 412.8 → 362.4ms, 지도 묶음 131.1 → 126.6ms, 지도 마커 8.0 → 7.5ms.
      읽은 버퍼 수는 같다.
    -->
    <sql id="latestRiskJoin">
        LEFT JOIN risk_analysis ra ON ra.property_id = p.property_id AND ra.is_latest = TRUE
    </sql>

    <!-- 코드 값을 쓰지 않는 조회 — 자치구 집계 · 지도 묶음 -->
    <sql id="fromPropertyRisk">
        FROM property p
        <include refid="latestRiskJoin"/>
    </sql>

    <!-- 계약 유형만 고르는 조회 — 지도 마커 -->
    <sql id="fromPropertyRiskContractType">
        FROM property p
        JOIN property_code ct ON ct.code_id = p.contract_type_code_id
        <include refid="latestRiskJoin"/>
    </sql>

    <!-- 계약 유형 · 매물 유형을 모두 고르는 조회 — 목록 · 상세. 목록은 최신 분석 조인을 따로 고르므로 코드 조인만 둔다. -->
    <sql id="fromPropertyCodes">
        FROM property p
        JOIN property_code ct ON ct.code_id = p.contract_type_code_id
        JOIN property_code pt ON pt.code_id = p.property_type_code_id
    </sql>

    <!--
      공통 검색 필터(명세 1.1) + 바운딩 박스(영속성 구조 1.3). 경계를 포함한다.
      바운딩 박스 네 값은 NUMERIC 으로 바꿔 넘긴다. latitude · longitude 는 NUMERIC 열인데 조건 값이 Double(float8)이면
      PostgreSQL 이 열 쪽을 float8 로 바꿔 비교해 좌표 인덱스(V3 · V15)를 타지 못한다 — 지도 3단계 201 → 30.9ms(운영 측정, #321 PR 본문).
      BETWEEN(경계 포함)은 그대로다. float8 → NUMERIC 변환은 유효 15자리로 맞추므로 요청이 보낸 좌표(10자리 이내)는 값이 바뀌지
      않는다. 반경에서 계산한 경계는 15자리 밖 끝자리(1e-13 아래)만 달라지고, 바운딩 박스는 1차 필터라 최종 판정은 거리 계산이 한다.
      셀 번호 식(cellRow · cellCol)은 조건이 아니라 SELECT 식이라 그대로 둔다.
      계약 유형 · 매물 유형은 코드 테이블을 조인하지 않고 식별자로 비교한다 — 조인이 없는 조회에도 같은 필터를 걸기 위해서다.
      하위 질의는 유일 제약 uq_property_code_group_value (code_group, code_value)(V1)로 한 행을 찾고, 바깥 행과 무관해
      InitPlan 으로 한 번만 계산된다.
    -->
    <sql id="filter">
        <where>
            <if test="district != null and district != ''">
                AND p.district = #{district}
            </if>
            <if test="contractType != null">
                AND p.contract_type_code_id = (SELECT code_id FROM property_code
                                                WHERE code_group = 'CONTRACT_TYPE' AND code_value = #{contractType})
            </if>
            <if test="propertyType != null">
                AND p.property_type_code_id = (SELECT code_id FROM property_code
                                                WHERE code_group = 'PROPERTY_TYPE' AND code_value = #{propertyType})
            </if>
            <if test="depositMin != null">
                AND p.deposit &gt;= #{depositMin}
            </if>
            <if test="depositMax != null">
                AND p.deposit &lt;= #{depositMax}
            </if>
            <if test="monthlyRentMax != null">
                AND COALESCE(p.monthly_rent, 0) &lt;= #{monthlyRentMax}
            </if>
            <if test="areaMin != null">
                AND p.area_sqm &gt;= #{areaMin}
            </if>
            <if test="areaMax != null">
                AND p.area_sqm &lt;= #{areaMax}
            </if>
            <!-- 등급을 지정하면 분석된 매물만 대상이다. NULL 은 IN 에 걸리지 않는다. -->
            <if test="riskGrades != null and !riskGrades.isEmpty()">
                AND ra.risk_grade IN
                <foreach collection="riskGrades" item="grade" open="(" separator="," close=")">
                    #{grade}
                </foreach>
            </if>
            <if test="minLat != null and maxLat != null and minLng != null and maxLng != null">
                AND p.latitude BETWEEN CAST(#{minLat} AS NUMERIC) AND CAST(#{maxLat} AS NUMERIC)
                AND p.longitude BETWEEN CAST(#{minLng} AS NUMERIC) AND CAST(#{maxLng} AS NUMERIC)
            </if>
            <!-- 목록 키셋. 정렬 값이 같은 행은 식별자로 가른다. 목록 외 조회는 lastId 가 null 이다. -->
            <if test="lastId != null">
                AND (<include refid="sortExpr"/> <include refid="keysetOp"/> <include refid="lastSortValue"/>
                     OR (<include refid="sortExpr"/> = <include refid="lastSortValue"/>
                         AND p.property_id <include refid="keysetOp"/> #{lastId}))
            </if>
        </where>
    </sql>

    <!--
      record 를 돌려주는 조회는 resultType 자동 매핑 대신 이름 지정 <constructor> 로 받는다(#397).
      인자 이름 자동 매핑(arg-name-based-constructor-auto-mapping)은 행마다 생성자를 다시 찾고, 인자마다 이름을 리플렉션으로 읽어
      모든 컬럼 이름과 비교한다(MyBatis 3.5.19 DefaultResultSetHandler.applyArgNameBasedConstructorAutoMapping). 운영 프로파일
      (#390 P01)에서 반경 요청(1 km 약 1,400행) CPU 샘플 183 중 156(85 %)이 이 매핑이었다.
      이름 지정 <constructor> 는 기동 때 한 번 인자 이름 · 타입으로 생성자를 맞추고(ResultMap.Builder.argNamesOfMatchingConstructor),
      못 찾으면 기동이 실패한다. 순서가 아니라 이름으로 맞추므로 record 컴포넌트 순서가 바뀌어도 조용히 틀리지 않는다.
      record 는 setter 가 없어 javaType 이 필요하고, 생성자 인자 타입과 정확히 같아야 한다(원시형 · 상위 타입이면 못 찾는다).
      column 은 SQL 의 별칭, name 은 record 컴포넌트 이름이다. SELECT 에 컬럼을 더하면 여기에도 더한다.
    -->
    <resultMap id="districtCountRow" type="com.duri.rentalplatform.domain.property.vo.DistrictCountRow">
        <constructor>
            <arg column="name" name="name" javaType="String"/>
            <arg column="total_count" name="totalCount" javaType="Long"/>
            <arg column="safe_count" name="safeCount" javaType="Long"/>
            <arg column="caution_count" name="cautionCount" javaType="Long"/>
            <arg column="danger_count" name="dangerCount" javaType="Long"/>
        </constructor>
    </resultMap>

    <select id="selectDistrictCounts" resultMap="districtCountRow">
        SELECT p.district AS name,
               COUNT(*) AS total_count,
               SUM(CASE WHEN ra.risk_grade = 'SAFE' THEN 1 ELSE 0 END) AS safe_count,
               SUM(CASE WHEN ra.risk_grade = 'CAUTION' THEN 1 ELSE 0 END) AS caution_count,
               SUM(CASE WHEN ra.risk_grade = 'DANGER' THEN 1 ELSE 0 END) AS danger_count
        <include refid="fromPropertyRisk"/>
        <include refid="filter"/>
        GROUP BY p.district
        ORDER BY p.district
    </select>

    <!--
      지도 마커 응답(명세 1.4)의 컬럼. 바운딩 박스 조회와 식별자 조회가 함께 쓴다.
      선순위 채무 EXISTS 는 senior_debt_yn 을 보지 않는다 — 계약 전 조회자에게 등기상 유효 항목은 전부 선순위라 수집 경로가 늘 참으로
      저장한다(MortgageHistory.record). 조건을 빼면 부분 인덱스 idx_mortgage_history_registry_active (registry_id) WHERE is_active
      (V19)만으로 인덱스 전용 스캔이 된다. 선순위가 아닌 항목을 저장하는 경로가 생기면 조건과 인덱스를 함께 다시 본다.
    -->
    <sql id="markerColumns">
        SELECT p.property_id,
               p.latitude,
               p.longitude,
               p.deposit,
               ra.risk_grade,
               ct.code_value AS contract_type,
               COALESCE(p.monthly_rent, 0) AS monthly_rent,
               p.district,
               ra.lease_ratio AS debt_ratio,
               CASE WHEN ra.risk_id IS NULL THEN NULL
                    ELSE EXISTS (SELECT 1
                                   FROM mortgage_history mh
                                  WHERE mh.registry_id = ra.registry_id
                                    AND mh.is_active = TRUE)
               END AS has_senior_debt
    </sql>

    <!-- markerColumns 의 컬럼. 마커 · 마커 식별자 조회가 함께 쓴다. 이름 지정 <constructor> 인 이유는 districtCountRow 위 주석 -->
    <resultMap id="propertyMarker" type="com.duri.rentalplatform.domain.property.dto.response.PropertyMarkerResponse">
        <constructor>
            <arg column="property_id" name="propertyId" javaType="Long"/>
            <arg column="latitude" name="latitude" javaType="java.math.BigDecimal"/>
            <arg column="longitude" name="longitude" javaType="java.math.BigDecimal"/>
            <arg column="deposit" name="deposit" javaType="Long"/>
            <arg column="risk_grade" name="riskGrade" javaType="com.duri.rentalplatform.domain.property.enums.RiskGrade"/>
            <arg column="contract_type" name="contractType" javaType="com.duri.rentalplatform.domain.property.enums.ContractType"/>
            <arg column="monthly_rent" name="monthlyRent" javaType="Long"/>
            <arg column="district" name="district" javaType="String"/>
            <arg column="debt_ratio" name="debtRatio" javaType="java.math.BigDecimal"/>
            <arg column="has_senior_debt" name="hasSeniorDebt" javaType="Boolean"/>
        </constructor>
    </resultMap>

    <select id="selectMarkers" resultMap="propertyMarker">
        <include refid="markerColumns"/>
        <include refid="fromPropertyRiskContractType"/>
        <include refid="filter"/>
        ORDER BY p.property_id
    </select>

    <select id="selectMarkersByIds" resultMap="propertyMarker">
        <include refid="markerColumns"/>
        <include refid="fromPropertyRiskContractType"/>
        WHERE p.property_id IN
        <foreach collection="propertyIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY p.property_id
    </select>

    <!--
      지도 묶음 격자 칸 번호(명세 1.12). floor((좌표 - 최소) / 칸 크기) 를 0 ~ maxCellIndex 로 자른다 —
      최대 경계 위 좌표는 마지막 칸에 든다. 칸 크기가 0(최소 = 최대)이면 나눌 수 없어 모두 0번 칸이다.
    -->
    <sql id="cellRow">
        <choose>
            <when test="cellLat == 0">0</when>
            <otherwise>
                CASE WHEN FLOOR((p.latitude - #{minLat}) / #{cellLat}) &lt; 0 THEN 0
                     WHEN FLOOR((p.latitude - #{minLat}) / #{cellLat}) &gt; #{maxCellIndex} THEN #{maxCellIndex}
                     ELSE CAST(FLOOR((p.latitude - #{minLat}) / #{cellLat}) AS INTEGER) END
            </otherwise>
        </choose>
    </sql>

    <sql id="cellCol">
        <choose>
            <when test="cellLng == 0">0</when>
            <otherwise>
                CASE WHEN FLOOR((p.longitude - #{minLng}) / #{cellLng}) &lt; 0 THEN 0
                     WHEN FLOOR((p.longitude - #{minLng}) / #{cellLng}) &gt; #{maxCellIndex} THEN #{maxCellIndex}
                     ELSE CAST(FLOOR((p.longitude - #{minLng}) / #{cellLng}) AS INTEGER) END
            </otherwise>
        </choose>
    </sql>

    <!-- 이름 지정 <constructor> 인 이유는 districtCountRow 위 주석 -->
    <resultMap id="mapClusterCellRow" type="com.duri.rentalplatform.domain.property.vo.MapClusterCellRow">
        <constructor>
            <arg column="row_index" name="rowIndex" javaType="Integer"/>
            <arg column="col_index" name="colIndex" javaType="Integer"/>
            <arg column="count" name="count" javaType="Long"/>
            <arg column="latitude" name="latitude" javaType="java.math.BigDecimal"/>
            <arg column="longitude" name="longitude" javaType="java.math.BigDecimal"/>
            <arg column="safe_count" name="safeCount" javaType="Long"/>
            <arg column="caution_count" name="cautionCount" javaType="Long"/>
            <arg column="danger_count" name="dangerCount" javaType="Long"/>
            <arg column="unanalyzed_count" name="unanalyzedCount" javaType="Long"/>
            <arg column="representative_id" name="representativeId" javaType="Long"/>
        </constructor>
    </resultMap>

    <!-- 미분석은 최신 분석이 없는 매물이다. risk_grade 는 NOT NULL 이라 NULL 이면 LEFT JOIN 에서 빠진 것이다. -->
    <select id="selectClusterCells" resultMap="mapClusterCellRow">
        SELECT g.row_index,
               g.col_index,
               COUNT(*) AS count,
               ROUND(AVG(g.latitude), 7) AS latitude,
               ROUND(AVG(g.longitude), 7) AS longitude,
               SUM(CASE WHEN g.risk_grade = 'SAFE' THEN 1 ELSE 0 END) AS safe_count,
               SUM(CASE WHEN g.risk_grade = 'CAUTION' THEN 1 ELSE 0 END) AS caution_count,
               SUM(CASE WHEN g.risk_grade = 'DANGER' THEN 1 ELSE 0 END) AS danger_count,
               SUM(CASE WHEN g.risk_grade IS NULL THEN 1 ELSE 0 END) AS unanalyzed_count,
               MIN(g.property_id) AS representative_id
          FROM (SELECT p.property_id,
                       p.latitude,
                       p.longitude,
                       ra.risk_grade,
                       <include refid="cellRow"/> AS row_index,
                       <include refid="cellCol"/> AS col_index
                <include refid="fromPropertyRisk"/>
                <include refid="filter"/>) g
         GROUP BY g.row_index, g.col_index
         ORDER BY g.row_index, g.col_index
    </select>

    <!-- 목록 정렬 식. 전세가율은 미분석을 대체값으로 바꿔 방향과 무관하게 맨 뒤로 보낸다. -->
    <sql id="sortExpr">
        <choose>
            <when test="sortKey.name() == 'DEPOSIT'">p.deposit</when>
            <when test="sortKey.name() == 'DEBT_RATIO'">COALESCE(ra.lease_ratio, #{nullDebtRatio})</when>
            <otherwise>p.registered_at</otherwise>
        </choose>
    </sql>

    <sql id="lastSortValue">
        <choose>
            <when test="sortKey.name() == 'DEPOSIT'">#{lastDeposit}</when>
            <when test="sortKey.name() == 'DEBT_RATIO'">#{lastDebtRatio}</when>
            <otherwise>#{lastRegisteredAt}</otherwise>
        </choose>
    </sql>

    <sql id="keysetOp">
        <choose>
            <when test="ascending">&gt;</when>
            <otherwise>&lt;</otherwise>
        </choose>
    </sql>

    <sql id="sortDir">
        <choose>
            <when test="ascending">ASC</when>
            <otherwise>DESC</otherwise>
        </choose>
    </sql>

    <!-- 목록 두 조회(selectList · selectListByLeaseRatioIndex)가 함께 쓴다. 이름 지정 <constructor> 인 이유는 districtCountRow 위 주석 -->
    <resultMap id="propertyListRow" type="com.duri.rentalplatform.domain.property.dto.response.PropertyListResponse">
        <constructor>
            <arg column="property_id" name="propertyId" javaType="Long"/>
            <arg column="district" name="district" javaType="String"/>
            <arg column="address" name="address" javaType="String"/>
            <arg column="property_type" name="propertyType" javaType="com.duri.rentalplatform.domain.property.enums.PropertyType"/>
            <arg column="contract_type" name="contractType" javaType="com.duri.rentalplatform.domain.property.enums.ContractType"/>
            <arg column="deposit" name="deposit" javaType="Long"/>
            <arg column="monthly_rent" name="monthlyRent" javaType="Long"/>
            <arg column="area_sqm" name="areaSqm" javaType="java.math.BigDecimal"/>
            <arg column="floor" name="floor" javaType="Integer"/>
            <arg column="risk_grade" name="riskGrade" javaType="com.duri.rentalplatform.domain.property.enums.RiskGrade"/>
            <arg column="debt_ratio" name="debtRatio" javaType="java.math.BigDecimal"/>
            <arg column="registered_at" name="registeredAt" javaType="java.time.OffsetDateTime"/>
        </constructor>
    </resultMap>

    <!--
      자치구를 지정하고 전세가율로 정렬하는 목록만 최신 분석을 매물 한 건씩 찾는다. 평범한 LEFT JOIN 이면 플래너가 최신 분석 전부를
      해시 조인한다 — risk_analysis 를 이력 행까지(약 300k) 병렬 순차 읽기한다. 매물마다 커버링 부분 유일 인덱스
      uq_risk_analysis_latest (property_id) INCLUDE (risk_id, risk_grade, lease_ratio, registry_id) WHERE is_latest(V19)를
      찾게 하면 운영 측정(5회 중앙값, #326) 강남구 142.6 → 64.0ms, 도봉구 80.9 → 17.1ms 다.
      자치구가 없으면(서울 전체) 같은 방식이 오히려 느려(457 → 835ms) 조건을 둘 다 걸 때만 쓴다.
      OFFSET 0 은 최적화 울타리다 — 없으면 PostgreSQL 이 하위 질의를 평범한 조인으로 펼쳐 다시 해시 조인을 고를 수 있다.
      별칭을 ra 로 두어 filter(ra.risk_grade) · sortExpr(ra.lease_ratio) · SELECT 목록이 그대로 쓴다. 하위 질의의 SELECT 에
      없는 ra 열을 새로 참조하면 여기에 더해야 한다.
      random_page_cost 를 1.1 로 낮추면 플래너가 스스로 이 계획을 고르는 것을 확인했지만(#326) 서버 설정이라 DB 설정 단계로
      미룬다. 그때까지 매퍼가 계획을 정한다.
    -->
    <select id="selectList" resultMap="propertyListRow">
        SELECT p.property_id,
               p.district,
               p.address,
               pt.code_value AS property_type,
               ct.code_value AS contract_type,
               p.deposit,
               COALESCE(p.monthly_rent, 0) AS monthly_rent,
               p.area_sqm,
               p.floor,
               ra.risk_grade,
               ra.lease_ratio AS debt_ratio,
               p.registered_at AT TIME ZONE 'Asia/Seoul' AS registered_at
        <include refid="fromPropertyCodes"/>
        <choose>
            <when test="district != null and district != '' and sortKey.name() == 'DEBT_RATIO'">
                LEFT JOIN LATERAL (SELECT r.risk_grade, r.lease_ratio
                                     FROM risk_analysis r
                                    WHERE r.property_id = p.property_id AND r.is_latest = TRUE
                                   OFFSET 0) ra ON TRUE
            </when>
            <otherwise>
                <include refid="latestRiskJoin"/>
            </otherwise>
        </choose>
        <include refid="filter"/>
        ORDER BY <include refid="sortExpr"/> <include refid="sortDir"/>, p.property_id <include refid="sortDir"/>
        LIMIT #{limit}
    </select>

    <!--
      자치구 없는 전세가율순 목록의 앞부분 — 판정이 있는 매물만, 판정 표의 부분 인덱스
      ix_risk_analysis_latest_lease_ratio (lease_ratio, property_id) INCLUDE (risk_grade) WHERE is_latest AND lease_ratio IS NOT NULL
      (V20)을 정렬 순서대로 읽고 LIMIT 에서 멈춘다. 운영 측정(#347, 8회 중앙값) 필터 없음 오름 693.5 → 0.3ms, 내림 816.1 → 0.3ms,
      등급 오름 370.1 → 0.3ms, 커서 오름 517.6 → 0.4ms.
      서비스(PropertyQueryService)가 자치구 · 매물 조건 필터(계약 · 유형 · 보증금 · 월세 · 면적 · 좌표)가 모두 없을 때만 부른다 —
      매물 조건 필터가 있으면 걸러지는 비율만큼 인덱스를 더 읽어 오름에서 93.9 → 313.3ms 로 나빠졌다(#347). 등급 필터는 INCLUDE
      열이라 허용한다. 커서는 앞부분 안(오름 < 1000 · 내림 > -1000)일 때만 넘어온다.

      범위 조건(오름 r.lease_ratio < 대체값 1000 · 내림 > -1000)을 빼지 않는다 — lease_ratio IS NOT NULL 만 있으면 플래너가
      이 부분 인덱스를 정렬 경로로 쓰지 않는다(정렬을 금지해도, #347 측정). 범위 조건은 selectList 의 COALESCE 정렬에서 대체값보다
      앞에 오는 행만 고르는 조건이기도 하다 — 판정 · 전세가율이 없는 매물과 대체값 경계 바깥 값은 맨 뒤(끝부분)라 여기서 빠지고,
      서비스가 이 조회가 limit 보다 적게 돌려줄 때 selectList 로 이어 읽는다.
      앞부분의 정렬 값은 lease_ratio 그대로라 selectList 의 COALESCE(ra.lease_ratio, 대체값)와 같고, 행 비교
      (lease_ratio, property_id) > (값, ID) 는 selectList 의 키셋 조건(값 > 또는 값 = 이고 ID >)과 같다.
    -->
    <select id="selectListByLeaseRatioIndex" resultMap="propertyListRow">
        SELECT p.property_id,
               p.district,
               p.address,
               pt.code_value AS property_type,
               ct.code_value AS contract_type,
               p.deposit,
               COALESCE(p.monthly_rent, 0) AS monthly_rent,
               p.area_sqm,
               p.floor,
               r.risk_grade,
               r.lease_ratio AS debt_ratio,
               p.registered_at AT TIME ZONE 'Asia/Seoul' AS registered_at
          FROM risk_analysis r
          JOIN property p ON p.property_id = r.property_id
          JOIN property_code ct ON ct.code_id = p.contract_type_code_id
          JOIN property_code pt ON pt.code_id = p.property_type_code_id
         WHERE r.is_latest
           AND r.lease_ratio IS NOT NULL
           <choose>
               <when test="ascending">AND r.lease_ratio &lt; #{nullDebtRatio}</when>
               <otherwise>AND r.lease_ratio &gt; #{nullDebtRatio}</otherwise>
           </choose>
        <if test="riskGrades != null and !riskGrades.isEmpty()">
           AND r.risk_grade IN
            <foreach collection="riskGrades" item="grade" open="(" separator="," close=")">
                #{grade}
            </foreach>
        </if>
        <if test="lastId != null">
           AND (r.lease_ratio, r.property_id) <include refid="keysetOp"/> (#{lastDebtRatio}, #{lastId})
        </if>
         ORDER BY r.lease_ratio <include refid="sortDir"/>, r.property_id <include refid="sortDir"/>
         LIMIT #{limit}
    </select>

    <!-- 한 행 조회지만 같은 방식으로 맞춘다. 이유는 districtCountRow 위 주석 -->
    <resultMap id="propertyDetailRow" type="com.duri.rentalplatform.domain.property.vo.PropertyDetailRow">
        <constructor>
            <arg column="property_id" name="propertyId" javaType="Long"/>
            <arg column="district" name="district" javaType="String"/>
            <arg column="address" name="address" javaType="String"/>
            <arg column="latitude" name="latitude" javaType="java.math.BigDecimal"/>
            <arg column="longitude" name="longitude" javaType="java.math.BigDecimal"/>
            <arg column="property_type" name="propertyType" javaType="com.duri.rentalplatform.domain.property.enums.PropertyType"/>
            <arg column="contract_type" name="contractType" javaType="com.duri.rentalplatform.domain.property.enums.ContractType"/>
            <arg column="deposit" name="deposit" javaType="Long"/>
            <arg column="monthly_rent" name="monthlyRent" javaType="Long"/>
            <arg column="area_sqm" name="areaSqm" javaType="java.math.BigDecimal"/>
            <arg column="floor" name="floor" javaType="Integer"/>
            <arg column="landlord_name" name="landlordName" javaType="String"/>
            <arg column="market_price" name="marketPrice" javaType="Long"/>
            <arg column="price_type" name="priceType" javaType="com.duri.rentalplatform.domain.property.enums.PriceType"/>
            <arg column="price_date" name="priceDate" javaType="java.time.LocalDate"/>
            <arg column="risk_grade" name="riskGrade" javaType="com.duri.rentalplatform.domain.property.enums.RiskGrade"/>
            <arg column="debt_ratio" name="debtRatio" javaType="java.math.BigDecimal"/>
            <arg column="insurance_eligible" name="insuranceEligible" javaType="Boolean"/>
            <arg column="wishlisted" name="wishlisted" javaType="Boolean"/>
            <arg column="registered_at" name="registeredAt" javaType="java.time.OffsetDateTime"/>
        </constructor>
    </resultMap>

    <select id="selectDetail" resultMap="propertyDetailRow">
        SELECT p.property_id,
               p.district,
               p.address,
               p.latitude,
               p.longitude,
               pt.code_value AS property_type,
               ct.code_value AS contract_type,
               p.deposit,
               COALESCE(p.monthly_rent, 0) AS monthly_rent,
               p.area_sqm,
               p.floor,
               p.landlord_name,
               p.market_price,
               p.price_type,
               p.price_date,
               ra.risk_grade,
               ra.lease_ratio AS debt_ratio,
               ra.insurance_eligible_yn AS insurance_eligible,
               <choose>
                   <when test="userId != null">
                       EXISTS (SELECT 1 FROM wishlist w
                                WHERE w.property_id = p.property_id AND w.user_id = #{userId})
                   </when>
                   <otherwise>FALSE</otherwise>
               </choose> AS wishlisted,
               p.registered_at AT TIME ZONE 'Asia/Seoul' AS registered_at
        <include refid="fromPropertyCodes"/>
        <include refid="latestRiskJoin"/>
        WHERE p.property_id = #{propertyId}
    </select>

    <!--
      최신 판정이 없는 매물 — 매물 갱신 배치(RISK-08)의 판정 대상. 신규 매물과, 판정이 실패해 남은 매물이 함께 나온다.
      재분석 대기 표시와 무관하게 최신 판정이 없으면 여기서 나온다(#338) — 아래 selectReanalysisPendingPropertyIds 는 최신 판정이
      있는 매물만 내주므로 두 갈래가 겹치지 않는다.
      전체 매물을 읽어 메모리에서 거르지 않고 NOT EXISTS 로 DB 가 거른다. 하위 질의는 부분 유일 인덱스
      uq_risk_analysis_latest (property_id) WHERE is_latest 로 풀리고(V9 에서 만들고 V19 에서 같은 이름의 커버링 인덱스로 교체),
      바깥은 PK 순서라 식별자 커서에 인덱스가 따로 필요 없다.
      실행 계획은 미검증 — 운영 규모 더미로 EXPLAIN 을 돌리지 않았다.
    -->
    <select id="selectUnanalyzedPropertyIds" resultType="java.lang.Long">
        SELECT p.property_id
        FROM property p
        <where>
            NOT EXISTS (SELECT 1 FROM risk_analysis ra
                         WHERE ra.property_id = p.property_id AND ra.is_latest = TRUE)
            <if test="lastPropertyId != null">
                AND p.property_id &gt; #{lastPropertyId}
            </if>
        </where>
        ORDER BY p.property_id
        LIMIT #{limit}
    </select>

    <!--
      판정 입력(시세 · 등기 · 대장)이 바뀌어 재분석을 기다리는 매물 — 매물 갱신 배치(RISK-08)의 재분석 대상. 시세를 바꾼 적재와
      등기 · 대장을 바꾼 쓰기가 is_reanalysis_pending(V18 — #399 에서 시세 전용에서 뜻을 넓힘)을 세우면 여기서 DB 가 거른다. 판정이
      성공하면 판정 기록 트랜잭션이 표시를 내리므로 실패 · 경합으로 남은 매물은 다음 회차에 다시 나온다. 최신 판정이 있는 매물만 낸다 — 최신 판정이 없는 대기 매물은 위
      selectUnanalyzedPropertyIds(새 매물 갈래)가 맡으므로 두 갈래가 겹치지 않는다(#338).
      부분 인덱스 ix_property_reanalysis_pending (property_id) WHERE is_reanalysis_pending (V18) 이 대기 매물만 식별자 순으로
      담고, EXISTS 하위 질의는 부분 유일 인덱스 uq_risk_analysis_latest 로 풀릴 것으로 보지만 실행 계획은 미검증 — 배포 뒤 운영
      EXPLAIN 으로 확인한다.
    -->
    <select id="selectReanalysisPendingPropertyIds" resultType="java.lang.Long">
        SELECT p.property_id
        FROM property p
        <where>
            p.is_reanalysis_pending = TRUE
            AND EXISTS (SELECT 1 FROM risk_analysis ra
                         WHERE ra.property_id = p.property_id AND ra.is_latest = TRUE)
            <if test="lastPropertyId != null">
                AND p.property_id &gt; #{lastPropertyId}
            </if>
        </where>
        ORDER BY p.property_id
        LIMIT #{limit}
    </select>
</mapper>
