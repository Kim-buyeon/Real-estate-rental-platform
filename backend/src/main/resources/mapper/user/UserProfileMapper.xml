<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  프로필 조회. API 명세서(회원 · 인증) 1.1.

  응답이 account · profile 두 중첩 객체라 묶음마다 조회를 나눠 각 record 에 자동 생성자 매핑한다.
  created_at 은 서울 벽시계 시각으로 저장되어 있어 AT TIME ZONE 으로 시각(timestamptz)을 확정해 넘긴다.
  탈퇴(deleted_at 이 있는) 사용자는 없는 사용자와 같이 조회되지 않는다.
-->
<mapper namespace="com.duri.rentalplatform.domain.user.mapper.UserProfileMapper">

    <select id="selectAccount" resultType="com.duri.rentalplatform.domain.user.dto.response.ProfileResponse$Account">
        SELECT u.name,
               u.phone,
               u.email,
               u.role,
               u.created_at AT TIME ZONE 'Asia/Seoul' AS created_at
        FROM users u
        WHERE u.user_id = #{userId}
          AND u.deleted_at IS NULL
    </select>

    <select id="selectProfile" resultType="com.duri.rentalplatform.domain.user.dto.response.ProfileResponse$Profile">
        SELECT u.annual_income,
               u.credit_score,
               u.existing_loan,
               u.existing_loan_annual_payment,
               u.has_house,
               u.own_fund
        FROM users u
        WHERE u.user_id = #{userId}
          AND u.deleted_at IS NULL
    </select>
</mapper>
