<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그 출력 설정.

  Spring Boot 기본 콘솔 설정을 가져다 쓰고 두 가지만 더한다 — 요청 추적 값(traceId)과 민감 값 마스킹이다.
  기본을 베껴 오지 않는다. 날짜 형식 · 색 · 라이브러리별 로그 레벨은 defaults.xml 이 갖고, Boot 가 바뀌면 함께 바뀐다.

  ※ 프로파일 분기(<springProfile>)를 두지 않는다. 이 프로젝트는 application.yml 한 개로 운용하고 프로파일 파일을
    두지 않는다 — 환경 차이는 환경 변수가 낸다. 여기에만 프로파일이 생기면 설정이 두 방식으로 갈린다.

  ※ 파일 출력(FileAppender)을 두지 않는다. 앱은 컨테이너로 뜨고 stdout 에 쓴 것을 Docker 로그 드라이버가 받아
    회전 · 보관한다. 컨테이너 안 파일에 쓰면 컨테이너를 교체할 때(슬롯 교체 배포) 로그가 사라지고, 회전을 앱과
    드라이버가 각자 하게 된다. 크기 · 보관 개수 상한은 Compose 의 로그 드라이버 설정이 갖는다 — 여기에 옮겨 적지 않는다.
-->
<configuration>

    <!--
      마스킹 변환기. users 테이블의 연소득 · 신용점수 · 기존 대출 · 자기 자금이 이름 · 이메일 · 전화번호와 같은 행에
      있어, 객체 toString() 이나 예외 메시지에 실려 로그로 샐 수 있다. 출력 직전 한 곳에서 가린다.
        %maskedMessage — 메시지 본문(%m 자리)
        %maskedWex     — 예외 출력(Boot 기본 %wEx 자리). 민감한 값은 예외 메시지에도 실린다
    -->
    <conversionRule conversionWord="maskedMessage"
                    class="com.duri.rentalplatform.common.logging.MaskingMessageConverter"/>
    <conversionRule conversionWord="maskedWex"
                    class="com.duri.rentalplatform.common.logging.MaskingThrowableProxyConverter"/>

    <!--
      콘솔 패턴. defaults.xml 이 CONSOLE_LOG_PATTERN 을 "이미 정의돼 있으면 그것을 쓴다"로 선언하므로,
      include 보다 먼저 정의해 기본 패턴 대신 이 값이 쓰이게 한다.

      기본 패턴과 다른 곳은 셋이다.
        [%X{traceId:-no-trace}] — RequestIdFilter 가 넣는 요청 추적 값. 한 요청의 로그를 두 슬롯의 출력에서
                                  골라내고 앞단 접근 로그와 잇는다. 기본값을 주는 이유는 요청 밖에서 나는 로그
                                  (기동 · 스케줄 배치)에 빈 대괄호만 남아 줄이 어지러워지는 것을 막기 위해서다.
        %maskedMessage          — %m 대신. 위 마스킹 변환기
        %maskedWex              — ${LOG_EXCEPTION_CONVERSION_WORD:-%wEx} 대신. 예외 출력도 가린다
      나머지(날짜 · 레벨 · PID · 스레드 · 로거)는 기본과 같게 둔다. 로그를 읽는 눈과 도구가 기본 형태를 전제한다.

      기본 패턴에서 뺀 것이 둘 더 있다.
        애플리케이션 이름(%esb) — 슬롯 둘의 이름이 같아 줄마다 같은 값이 반복된다. 어느 슬롯인지는
                                 앞단 접근 로그의 upstream 주소가 말한다
        ${LOG_CORRELATION_PATTERN} — 추적 정보를 넣는 자리인데 우리는 %X{traceId}로 직접 넣는다.
                                 지금은 빈 값이라 뺀 효과가 없지만, 남겨 두면 나중에 같은 값이 두 번 찍힌다
    -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}){} %clr(${PID:-}){magenta} %clr(--- [%15.15t] [%X{traceId:-no-trace}]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %maskedMessage%n%maskedWex"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 개별 로거 레벨은 여기서 정하지 않는다. application.yml 의 logging.level.* 가 이 설정 뒤에 적용된다. -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
