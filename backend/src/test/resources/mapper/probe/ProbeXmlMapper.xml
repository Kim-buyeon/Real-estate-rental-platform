<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  시험용 XML 매퍼. mybatis.mapper-locations(classpath*:mapper/**/*.xml)가 테스트 리소스의
  mapper/ 아래 XML 까지 실제로 잡는지, 그리고 XML 경로에서도 스네이크 → 카멜 생성자 매핑이
  적용되는지 확인하는 데만 쓴다. 프로덕션 매퍼 XML(main/resources/mapper/)이 아니다.

  테이블을 만들지 않는다. PostgreSQL 은 FROM 없는 SELECT 로 리터럴을 반환한다.
  SELECT 컬럼 순서와 resultType record 의 컴포넌트 순서를 일부러 어긋나게 두었다 —
  순서가 같으면 arg-name-based-constructor-auto-mapping 이 꺼져도 통과해 아무것도 검증하지 못한다.
-->
<mapper namespace="com.duri.rentalplatform.config.MyBatisConfigTest$XmlProbeMapper">

    <select id="selectFromXml"
            resultType="com.duri.rentalplatform.config.MyBatisConfigTest$XmlProbeRow">
        SELECT 11        AS property_id,
               '강남구'   AS district_name,
               0.80      AS debt_ratio_threshold
    </select>

</mapper>
