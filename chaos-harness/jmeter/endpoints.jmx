<TestAction guiclass="TestActionGui" testclass="TestAction" testname="SSE 계정 돌려놓기" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">0</stringProp></TestAction>
<hashTree>
<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="돌려놓기" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 계정을 돌려놓는다(SSE · 몰림 묶음) — 토큰을 계정에 돌려 적는다. 직전 요청이 401 이면 토큰을 버려 다음 빌림이 로그인한다
def s = vars.getObject('ep_session')
if (s != null) {
    if (prev != null &amp;&amp; prev.getResponseCode() == '401') vars.remove('access_token')
    String t = vars.get('access_token')
    boolean ok = t != null &amp;&amp; t != 'NOT_FOUND'
    s.access = ok ? t : null
    s.refresh = ok ? vars.get('refresh_token') : null
    s.at = ok ? vars.get('token_at') : null
    if (ok) s.loggedOut = false
    vars.remove('ep_session')
    props.get('ep_sessions').offer(s)
}
</stringProp></JSR223PreProcessor>
<hashTree/>
</hashTree>
<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="notifications/stream sse setup" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// SSE 연결 하나 — GET /api/notifications/stream?ticket= 을 열고 회차 끝(ep_t0 + hold_s)까지 읽는다. 하트비트(25초, 앱 설정)를
// 세 번 놓치면(읽기 90초) 끊긴 것으로 본다. 서버가 닫으면(토큰 남은 시간 — 앱) 성공으로 끝나고 다음 반복이 새 티켓으로 다시 연다.
// 표본 하나 = 연결 하나(elapsed = 연결 시간). 레이블이 setup 으로 끝나 집계 · 판정에서 빠진다. 티켓 값은 남기지 않는다
import java.util.concurrent.TimeUnit
import java.util.zip.GZIPInputStream
import javax.net.ssl.HttpsURLConnection

long deadline = (props.get('ep_t0') as long) + ((props.get('hold_s') ?: '0') as long) * 1000L
long left = deadline - System.currentTimeMillis()
if (left &lt;= 1000) { SampleResult.setIgnore(); ctx.getThread().stop(); return }
String ticket = vars.get('sse_ticket')
if (!ticket || ticket == 'NOT_FOUND') {
    SampleResult.setSuccessful(false); SampleResult.setResponseCode('NO_TICKET'); SampleResult.setResponseMessage('티켓을 받지 못했다')
    Thread.sleep(1000); return
}
vars.put('sse_ticket', 'NOT_FOUND')     // 일회용

def url = new URL(props.get('protocol') ?: 'https', props.get('host') ?: 'localhost', ((props.get('port') ?: '443') as String).toInteger(),
        '/api/notifications/stream?ticket=' + URLEncoder.encode(ticket, 'UTF-8'))
def conn = url.openConnection()
if (conn instanceof HttpsURLConnection) { conn.setSSLSocketFactory(props.get('ep_sse_ssl')); conn.setHostnameVerifier(props.get('ep_sse_hv')) }
conn.setConnectTimeout(5000)
conn.setReadTimeout(90000)
conn.setUseCaches(false)
conn.setRequestProperty('Accept', 'text/event-stream')
conn.setRequestProperty('Accept-Encoding', 'gzip')
conn.setRequestProperty('Cache-Control', 'no-cache')
def guard = props.get('ep_sse_timer').schedule({ conn.disconnect() } as Runnable, left, TimeUnit.MILLISECONDS)
int code = -1
long lines = 0, beats = 0
String end = 'server-close'
try {
    code = conn.getResponseCode()
    SampleResult.setResponseCode(String.valueOf(code))
    if (code == 200) {
        SampleResult.latencyEnd()
        def ins = conn.getInputStream()
        if ('gzip'.equalsIgnoreCase(conn.getContentEncoding())) ins = new GZIPInputStream(ins)
        ins.withReader('UTF-8') { r -&gt; String ln; while ((ln = r.readLine()) != null) { lines++; if (ln.startsWith(':')) beats++ } }
    }
} catch (java.net.SocketTimeoutException e) {
    end = 'read-timeout'
} catch (IOException e) {
    end = System.currentTimeMillis() &gt;= deadline - 100 ? 'deadline' : 'io ' + e.getClass().getSimpleName()
} finally {
    guard.cancel(false)
    conn.disconnect()
}
if (end == 'server-close' &amp;&amp; System.currentTimeMillis() &gt;= deadline - 100) end = 'deadline'
SampleResult.setSuccessful(code == 200 &amp;&amp; (end == 'server-close' || end == 'deadline'))
SampleResult.setResponseMessage('end=' + end + ' lines=' + lines + ' heartbeats=' + beats)
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
</stringProp></JSR223Sampler>
<hashTree/>
</hashTree>
<!-- 로그인 몰림(S4, login_burst > 0 일 때) — burst_delay_s 뒤 login_burst_s 초 동안 계정마다 한 번 로그인. 타이머 밖이라 초당 요청 수에 들지 않고, 빌린 계정의 토큰을 새 것으로 바꿔 돌려놓는다 -->
<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="로그인 몰림" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(login_burst,0)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(login_burst_s,10)}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(hold_s,0)}</stringProp><stringProp name="ThreadGroup.delay">${__P(burst_delay_s,30)}</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup>
<hashTree>
<TestAction guiclass="TestActionGui" testclass="TestAction" testname="몰림 계정 빌리기" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">0</stringProp></TestAction>
<hashTree>
<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="빌리기" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 계정을 빌린다(SSE · 몰림 묶음) — 엔드포인트 묶음과 같은 줄에서 빌리므로 한 계정을 두 스레드가 같이 쓰지 않는다
if (props.get('ep_ready') != 'true') { ctx.getThread().stop(); return }
def q = props.get('ep_sessions')
def s = q.poll()
long waited = 0
while (s == null) {
    Thread.sleep(5); waited += 5; s = q.poll()
    if (waited == 5000) log.warn('[endpoints] (' + ctx.getThreadGroup().getName() + ') 빌릴 계정이 5초째 없다 — 계정 수 &lt; 동시 스레드 수')
}
vars.putObject('ep_session', s)
vars.put('email', s.email)
vars.put('password', s.password)
if (s.access) {
    vars.put('access_token', s.access); vars.put('refresh_token', s.refresh ?: 'NOT_FOUND'); vars.put('token_at', s.at ?: '0')
} else {
    vars.remove('access_token'); vars.remove('refresh_token'); vars.remove('token_at')
}
vars.put('sse_ticket', 'NOT_FOUND')
</stringProp></JSR223PreProcessor>
