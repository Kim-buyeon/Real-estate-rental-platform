<TestAction guiclass="TestActionGui" testclass="TestAction" testname="계정 돌려놓기" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">0</stringProp></TestAction>
<hashTree>
<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="돌려놓기" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 반복 끝 — 토큰을 계정에 돌려 적고 계정을 돌려놓는다
def s = vars.getObject('ep_session')
if (s != null) {
    String t = vars.get('access_token')
    boolean ok = t != null &amp;&amp; t != 'NOT_FOUND'
    s.access = ok ? t : null
    s.refresh = ok ? vars.get('refresh_token') : null
    s.at = ok ? vars.get('token_at') : null
    vars.remove('ep_session')
    props.get('ep_sessions').offer(s)
}
</stringProp></JSR223PreProcessor>
