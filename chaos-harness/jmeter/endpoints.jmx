<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="알림 ID" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 알림 ID 받기(준비) 뒤 — 그 계정의 알림 ID 를 계정에 붙여 둔다(다음 반복부터 다시 받지 않는다). 없으면 빈 목록
def s = vars.getObject('ep_session')
vars.put('noti_fetch', '0')
if (prev.getResponseCode() == '200') {
    // 앞의 추출기(noti_ids, 일치 전부)가 noti_ids_1 … noti_ids_&lt;matchNr&gt; 를 남긴다. 없으면 matchNr = 0
    int n = (vars.get('noti_ids_matchNr') ?: '0') as int
    s.noti = (1..n).findAll { n &gt; 0 }.collect { vars.get('noti_ids_' + it) as long }
    if (s.noti.isEmpty()) {
        vars.put('noti_has', '0'); vars.put('noti_id', '0')
        log.info('[endpoints] ' + s.email.replaceAll('@.*', '@…') + ' 알림 없음 — notifications/{id}/read none(404 기대)로 보낸다')
    } else {
        vars.put('noti_has', '1')
        vars.put('noti_id', String.valueOf(s.noti[java.util.concurrent.ThreadLocalRandom.current().nextInt(s.noti.size())]))
    }
}
</stringProp></JSR223PostProcessor>
<hashTree/>
</hashTree>
</hashTree>
