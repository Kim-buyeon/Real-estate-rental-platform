<JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="알림 ID 전부" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">noti_ids</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.data.items[*].notificationId</stringProp><stringProp name="JSONPostProcessor.match_numbers">-1</stringProp><stringProp name="JSONPostProcessor.defaultValues">NONE</stringProp></JSONPostProcessor>
