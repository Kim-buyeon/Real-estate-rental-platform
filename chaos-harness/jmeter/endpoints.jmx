def s = vars.getObject('ep_session')
if (s != null) {
    String t = vars.get('access_token')
    boolean ok = t != null &amp;&amp; t != 'NOT_FOUND'
    s.access = ok ? t : null
    s.refresh = ok ? vars.get('refresh_token') : null
    s.at = ok ? vars.get('token_at') : null
    vars.remove('ep_session')
    props.get('ep_sessions').offer(s)
}
