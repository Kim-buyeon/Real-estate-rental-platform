<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="알림 ID" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 알림 ID 받기(준비) 뒤 — 읽지 않은 것 · 읽은 것을 계정에 붙여 두고(다음 반복부터 다시 받지 않는다) 이번 읽음 대상을 고른다
def s = vars.getObject('ep_session')
vars.put('noti_fetch', '0')
if (s != null &amp;&amp; prev.getResponseCode() == '200') {
    // 앞의 추출기(일치 전부)가 &lt;이름&gt;_1 … &lt;이름&gt;_&lt;matchNr&gt; 를 남긴다. 없으면 matchNr = 0
    def ids = { String name -&gt; int n = (vars.get(name + '_matchNr') ?: '0') as int; n &gt; 0 ? (1..n).collect { vars.get(name + '_' + it) as long } : [] }
    s.unread = ids('noti_ids')
    s.read = ids('noti_read_ids')
    def rnd = java.util.concurrent.ThreadLocalRandom.current()
    if (!s.unread.isEmpty()) {
        def id = s.unread.remove(rnd.nextInt(s.unread.size())); s.read &lt;&lt; id
        vars.put('noti_mode', 'unread'); vars.put('noti_id', String.valueOf(id))
    } else if (!s.read.isEmpty()) {
        vars.put('noti_mode', 'again'); vars.put('noti_id', String.valueOf(s.read[rnd.nextInt(s.read.size())]))
        log.info('[endpoints] ' + s.email.replaceAll('@.*', '@…') + ' 읽지 않은 알림 없음 — notifications/{id}/read again 으로 보낸다')
    } else {
        vars.put('noti_mode', 'none'); vars.put('noti_id', '0')
        log.info('[endpoints] ' + s.email.replaceAll('@.*', '@…') + ' 알림 없음 — notifications/{id}/read none(404 기대)로 보낸다')
    }
}
</stringProp></JSR223PostProcessor>
