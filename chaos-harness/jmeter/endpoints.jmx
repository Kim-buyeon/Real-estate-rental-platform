if (prev.getResponseCode() == '200' &amp;&amp; vars.get('access_token') != 'NOT_FOUND') {
    vars.put('token_at', String.valueOf(System.currentTimeMillis()))
}
vars.put('auth401', '0')
</stringProp></JSR223PostProcessor>
