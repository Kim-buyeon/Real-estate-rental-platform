<GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="properties-radius" enabled="true"/>
<hashTree>
<!-- 반경 1 km — API 명세서(매물) 1.3 「동 단위 1 km」. 중심 = 표본 매물 좌표. 화면은 부르지 않는다 — 혼합 0 %, 단독 회차만 -->
