<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="토큰 버림" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 로그아웃 뒤 — 토큰을 버린다. 단독(logout)은 다음 반복이 준비 로그인(auth/login setup)으로, 혼합은 다음에 이 계정을 빌린
// 반복이 로그인(auth/login — 혼합 몫)으로 다시 들어온다(고르기)
if (prev.getResponseCode() == '200') {
    vars.remove('access_token'); vars.remove('refresh_token'); vars.remove('token_at')
    def s = vars.getObject('ep_session')
    if (s != null &amp;&amp; (props.get('target') ?: 'mix') == 'mix') s.loggedOut = true
}
</stringProp></JSR223PostProcessor>
<hashTree/>
</hashTree>
</hashTree>
