<hashTree/>
<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="관심 ID 기억" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 관심 매물 목록 뒤 — 첫 쪽의 매물 ID 를 계정에 붙여 둔다
def s = vars.getObject('ep_session')
if (s != null &amp;&amp; prev.getResponseCode() == '200') {
    int n = (vars.get('wl_ids_matchNr') ?: '0') as int
    s.wl = n &gt; 0 ? (1..n).collect { vars.get('wl_ids_' + it) } : []
}
</stringProp></JSR223PostProcessor>
