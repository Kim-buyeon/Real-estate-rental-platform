<TestAction guiclass="TestActionGui" testclass="TestAction" testname="CSV 읽기" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">0</stringProp></TestAction>
<hashTree>
<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CSV 읽기" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 준비(setUp, 한 번) — 대상 확인 · CSV 둘을 읽어 모든 스레드가 같이 쓰는 목록을 props 에 둔다. 비밀번호는 로그에 남기지 않는다.
import org.apache.jmeter.services.FileServer
import java.util.concurrent.ConcurrentLinkedQueue
import java.util.concurrent.Executors
import java.util.concurrent.ThreadFactory
import javax.net.ssl.HostnameVerifier
import javax.net.ssl.SSLContext
import javax.net.ssl.TrustManager
import javax.net.ssl.X509TrustManager
import java.security.cert.X509Certificate

def fail = { String msg -&gt;
    log.error('[endpoints] ' + msg)
    props.put('ep_ready', 'false')
    ctx.getEngine().stopTest(true)
}
props.put('ep_ready', 'false')

def TARGETS = ['district-counts', 'map-clusters', 'properties-radius', 'properties-list', 'property-detail', 'property-risk',
               'wishlist-read', 'wishlist-add', 'wishlist-remove', 'wishlist-write', 'loans-limit', 'notifications',
               'ledger', 'registry', 'profile-read', 'profile-write', 'subscriptions-read', 'subscriptions-write', 'reissue',
               'notification-read', 'notification-read-all', 'login', 'logout', 'stream-ticket', 'mix']
String target = props.get('target') ?: 'mix'
if (!TARGETS.contains(target)) { fail('target 이 목록에 없다: ' + target + ' — ' + TARGETS.join(' ')); return }

// 혼합 — develop 화면 호출 흐름의 DAU 1인 하루 요청 수 × 100(합 5,365 = 53.65 요청). 근거와 계산은 ENDPOINTS.md 3장.
// 반경(properties-radius)은 화면이 부르지 않아 0 이다(단독 회차만). login 은 10 − 5 — 로그아웃(5)한 계정은 다음에 빌려질 때
// 로그인을 하나 더 내므로(고르기) 둘을 합쳐 10 이 된다
def MIX = [['map-clusters', 1700], ['property-detail', 730], ['properties-list', 700], ['property-risk', 600], ['loans-limit', 600],
           ['notifications', 260], ['reissue', 100], ['stream-ticket', 100], ['district-counts', 100], ['ledger', 100], ['registry', 100],
           ['wishlist-add', 100], ['wishlist-remove', 30], ['wishlist-read', 50], ['notification-read', 30], ['notification-read-all', 10],
           ['profile-read', 15], ['profile-write', 5], ['subscriptions-read', 15], ['subscriptions-write', 5], ['login', 5], ['logout', 5]]
props.put('ep_mix', MIX)

// 목록 요청의 모양 — 화면(PropertyFilterBar · PropertyList · RecentProperties)이 보낼 수 있는 값만. 각 확률(%)은 근거가 없는
// 시험 가정이다(미확정 — ENDPOINTS.md 3장). 커서는 직전 목록 응답의 nextCursor 를 같은 조건으로 이어 붙인다
props.put('ep_list', [districtPct: 75, contractPct: 20, depositPct: 20, gradePct: 20, sortPct: 50, nextPct: 30,
                      contracts: ['DEPOSIT_ONLY', 'MONTHLY_RENT', 'SEMI_DEPOSIT'],
                      deposits : ['100000000', '200000000', '300000000', '500000000'],
                      grades   : [['SAFE'], ['SAFE', 'CAUTION']],
                      sorts    : ['deposit,asc', 'deposit,desc', 'debtRatio,asc', 'debtRatio,desc', 'registeredAt,asc']])

// 지도 묶음 — frontend/src/features/property/map/constants.ts 의 값 그대로(타일 단위 0.0001도 · 레벨 1 부터, 실측 화면 폭 레벨 7,
// 타일당 칸 6 · 5, 상한 24). 레벨은 7 ~ 9(자치구 단계에서 화면이 쓰는 범위 — 7 이 진입, 8 · 9 는 축소)
def MAP = [lat: [8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536],
           lng: [16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072],
           screenLat: 0.09765d, screenLng: 0.26692d, perLat: 6, perLng: 5, max: 24, levels: [7, 8, 9]]

def base = FileServer.getFileServer().getBaseDir()
def fileOf = { String p -&gt; def f = new File(p); f.isAbsolute() ? f : new File(base, p) }
def readCsv = { File f -&gt;
    def lines = f.readLines('UTF-8').collect { it.replace('﻿', '').replace('\r', '') }.findAll { it.trim() }
    if (lines.isEmpty()) return []
    def head = lines[0].split(',', -1).collect { it.trim() }
    lines.drop(1).collect { ln -&gt; def v = ln.split(',', -1); def m = [:]; head.eachWithIndex { h, i -&gt; m[h] = i &lt; v.length ? v[i].trim() : '' }; m }
}

// 계정 — 회차 동안 계정 하나는 한 번에 한 스레드만 쓴다(반복마다 빌리고 돌려놓는다). 같은 계정을 두 스레드가 같이 쓰면
// 재발급 · 로그인이 서로의 리프레시 토큰을 밀어낸다(RefreshTokenStore 는 사용자당 하나)
String accPath = props.get('accounts')
if (!accPath) { fail('accounts(계정 CSV)가 없다 — run.sh 가 넘긴다'); return }
File accFile = fileOf(accPath)
if (!accFile.canRead()) { fail('계정 CSV 를 읽지 못했다: ' + accFile); return }
def accounts = readCsv(accFile).findAll { it.email &amp;&amp; it.password }
if (accounts.isEmpty()) { fail('계정 CSV 에 email,password 행이 없다: ' + accFile); return }
def sessions = new ConcurrentLinkedQueue()
// unread · read = 알림 ID(읽지 않은 것 · 읽은 것, 처음 한 번 받는다) · wl = 관심 목록 첫 쪽 · added = 이 시험이 등록한 매물 ·
// listNext = [목록 조건, 다음 커서] · loggedOut = 혼합에서 로그아웃함(다음 빌림이 로그인)
accounts.each { sessions.offer([email: it.email, password: it.password, access: null, refresh: null, at: null, flip: false,
                                unread: null, read: [], wl: [], added: [], listNext: null, loggedOut: false]) }
props.put('ep_sessions', sessions)

// 매물 표본 — property-ids.sql 의 출력. 기본 자리 = 계정 CSV 와 같은 폴더의 property-ids.csv
String idPath = props.get('property_ids')
File idFile = idPath ? fileOf(idPath) : new File(accFile.getAbsoluteFile().getParentFile(), 'property-ids.csv')
if (!idFile.canRead()) { fail('매물 표본 CSV 를 읽지 못했다: ' + idFile + ' — sql/property-ids.sql 로 만든다'); return }
def rows = readCsv(idFile).findAll { it.property_id &amp;&amp; it.district &amp;&amp; it.latitude &amp;&amp; it.longitude }
if (rows.isEmpty()) { fail('매물 표본이 비었다: ' + idFile); return }
def eligible = { String v -&gt; v in ['t', 'true', 'TRUE', 'True', '1'] }
def loanRows = rows.findAll { eligible(it.insurance_eligible) }
if (loanRows.isEmpty()) { fail('가입 가능(insurance_eligible) 매물이 없다 — loans/limit 이 전부 422'); return }
props.put('ep_rows', rows)
props.put('ep_loan_rows', loanRows)

// 쏠림(S3) — skew_pct % 의 요청을 한 자치구 · 같은 화면(그 구 표본 좌표의 가운데, 레벨 7)으로
int skewPct = ((props.get('skew_pct') ?: '0') as String).toInteger()
props.put('ep_skew_pct', skewPct)
if (skewPct &gt; 0) {
    String sd = props.get('skew_district') ?: ((rows.find { it.tier == 'top' } ?: rows[0]).district)
    def sr = rows.findAll { it.district == sd }
    if (sr.isEmpty()) { fail('skew_district 의 표본이 없다: ' + sd); return }
    def mid = { List xs -&gt; def s = xs.collect { it as double }.sort(); s[s.size().intdiv(2)] }
    MAP.skewLat = mid(sr*.latitude); MAP.skewLng = mid(sr*.longitude)
    props.put('ep_skew_rows', sr)
    props.put('ep_skew_loan_rows', sr.findAll { eligible(it.insurance_eligible) })
    log.info('[endpoints] 쏠림 ' + skewPct + '% → ' + sd + ' (표본 ' + sr.size() + ')')
}
props.put('ep_map', MAP)

// SSE 묶음 — 인증서를 검증하지 않는다(HTTP 요청 요소와 같다 — 사설 IP 로 보내고 인증서 SAN 은 공인 IP). 연결 끝 시각을 지키는 타이머 하나
def trustAll = [checkClientTrusted: { a, b -&gt; }, checkServerTrusted: { a, b -&gt; }, getAcceptedIssuers: { new X509Certificate[0] }] as X509TrustManager
def ssl = SSLContext.getInstance('TLS')
ssl.init(null, [trustAll] as TrustManager[], new java.security.SecureRandom())
props.put('ep_sse_ssl', ssl.getSocketFactory())
props.put('ep_sse_hv', { h, s -&gt; true } as HostnameVerifier)
props.put('ep_sse_timer', Executors.newSingleThreadScheduledExecutor({ Runnable r -&gt; def th = new Thread(r, 'sse-deadline'); th.setDaemon(true); th } as ThreadFactory))
props.put('ep_t0', String.valueOf(System.currentTimeMillis()))

props.put('ep_ready', 'true')
log.info('[endpoints] target=' + target + ' 계정 ' + accounts.size() + ' · 매물 ' + rows.size() + '(자치구 ' + rows*.district.unique().size()
        + ') · 가입 가능 ' + loanRows.size() + ' · sse ' + (props.get('sse') ?: '0') + ' · 몰림 ' + (props.get('login_burst') ?: '0'))
</stringProp></JSR223PreProcessor>
<hashTree/>
</hashTree>
</hashTree>
<com.blazemeter.jmeter.threads.concurrency.ConcurrencyThreadGroup guiclass="com.blazemeter.jmeter.threads.concurrency.ConcurrencyThreadGroupGui" testclass="com.blazemeter.jmeter.threads.concurrency.ConcurrencyThreadGroup" testname="엔드포인트" enabled="true"><elementProp name="ThreadGroup.main_controller" elementType="com.blazemeter.jmeter.control.VirtualUserController"/><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><stringProp name="TargetLevel">${__tstFeedback(ep_tst,${__P(start_threads,20)},${__P(max_threads,300)},10)}</stringProp><stringProp name="RampUp"></stringProp><stringProp name="Steps"></stringProp><stringProp name="Hold">${__P(hold_s,0)}</stringProp><stringProp name="LogFilename"></stringProp><stringProp name="Iterations"></stringProp><stringProp name="Unit">S</stringProp></com.blazemeter.jmeter.threads.concurrency.ConcurrencyThreadGroup>
<hashTree>
<!-- Flow Control Action(TestAction)은 표본을 남기지 않는다(sample 이 null) — 고르기 · 돌려놓기 스크립트의 자리로만 쓴다 -->
<TestAction guiclass="TestActionGui" testclass="TestAction" testname="계정 · 대상 고르기" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">0</stringProp></TestAction>
<hashTree>
<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="고르기" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 반복마다 — 계정을 빌리고(그 계정의 토큰 · 알림 ID 를 이어받는다) 이번 요청의 대상 · 매물 · 질의 문자열을 고른다.
import java.util.concurrent.ThreadLocalRandom

if (props.get('ep_ready') != 'true') { ctx.getThread().stop(); return }
def rnd = ThreadLocalRandom.current()

def q = props.get('ep_sessions')
def s = q.poll()
long waited = 0
while (s == null) {          // 계정보다 스레드가 많을 때만 — 부하 생성기 쪽 대기다(ENDPOINTS.md 「계정 수」)
    Thread.sleep(5); waited += 5; s = q.poll()
    if (waited == 5000) log.warn('[endpoints] 빌릴 계정이 5초째 없다 — 계정 수 &lt; 동시 스레드 수')
}
vars.putObject('ep_session', s)
vars.put('email', s.email)
vars.put('password', s.password)
if (s.access) {
    vars.put('access_token', s.access); vars.put('refresh_token', s.refresh ?: 'NOT_FOUND'); vars.put('token_at', s.at ?: '0')
} else {
    vars.remove('access_token'); vars.remove('refresh_token'); vars.remove('token_at')
}
vars.put('auth401', '0')

String target = props.get('target') ?: 'mix'
String ep = target
def weighted = { List w -&gt; int x = rnd.nextInt(w.sum { it[1] } as int); for (e in w) { x -= (e[1] as int); if (x &lt; 0) return e[0] }; w[0][0] }
if (target == 'mix') {
    // 혼합에서 로그아웃한 계정은 다음 반복이 로그인이다(화면: 로그아웃 → 다시 로그인). MIX 의 login 몫은 그만큼 작게 두었다
    if (s.loggedOut) { ep = 'login'; s.loggedOut = false } else ep = weighted(props.get('ep_mix'))
}
vars.put('ep', ep)

def enc = { String v -&gt; URLEncoder.encode(v, 'UTF-8') }
// 매물 · 자치구 — 표본에서 고르게(자치구마다 같은 수라 자치구도 고르다). 쏠림이면 skew_pct % 를 한 자치구에서
boolean skew = (props.get('ep_skew_pct') as int) &gt; 0 &amp;&amp; rnd.nextInt(100) &lt; (props.get('ep_skew_pct') as int)
def rows = skew ? props.get('ep_skew_rows') : props.get('ep_rows')
def row = rows[rnd.nextInt(rows.size())]
vars.put('pid', row.property_id)
vars.put('district', row.district)
vars.put('lat', row.latitude)
vars.put('lng', row.longitude)
def loanRows = (skew &amp;&amp; props.get('ep_skew_loan_rows')) ? props.get('ep_skew_loan_rows') : props.get('ep_loan_rows')
vars.put('loan_pid', loanRows[rnd.nextInt(loanRows.size())].property_id)

// 지도 묶음 — 화면 readMapArea 와 같은 식: (중심 ± 실측 화면 폭 / 2)를 그 레벨 타일 배수로 밖으로 맞추고(roundOutward),
// 행 · 열 = 타일 수 × 타일당 칸(상한 24, gridSize). 중심은 그 구의 표본 매물 좌표(구 안 여러 자리), 레벨 7 ~ 9.
// 쏠림이면 그 구 가운데 · 레벨 7 의 같은 화면
if (ep == 'map-clusters') {
    def m = props.get('ep_map')
    double cLat = skew ? (m.skewLat as double) : (row.latitude as double)
    double cLng = skew ? (m.skewLng as double) : (row.longitude as double)
    int level = skew ? 7 : (m.levels[rnd.nextInt(m.levels.size())] as int)
    double f = Math.pow(2, level - 7)
    double hLat = (m.screenLat as double) * f / 2, hLng = (m.screenLng as double) * f / 2
    int uLat = m.lat[level - 1] as int, uLng = m.lng[level - 1] as int
    def sc = { double v -&gt; new BigDecimal(v * 10000d).setScale(6, java.math.RoundingMode.HALF_UP).doubleValue() }
    long minLa = ((long) Math.floor(sc(cLat - hLat) / uLat)) * uLat
    long maxLa = ((long) Math.ceil(sc(cLat + hLat) / uLat)) * uLat
    long minLo = ((long) Math.floor(sc(cLng - hLng) / uLng)) * uLng
    long maxLo = ((long) Math.ceil(sc(cLng + hLng) / uLng)) * uLng
    def dec = { long units -&gt; BigDecimal.valueOf(units, 4).stripTrailingZeros().toPlainString() }
    int max = m.max as int
    def div = { long span, int unit, int per -&gt;
        int tiles = Math.max(1, Math.round(span / (double) unit) as int)
        Math.min(max, tiles * Math.min(per, Math.max(1, Math.floorDiv(max, tiles))))
    }
    int rowsN = div(maxLa - minLa, uLat, m.perLat as int), colsN = div(maxLo - minLo, uLng, m.perLng as int)
    vars.put('mc_qs', 'district=' + enc(row.district) + '&amp;minLat=' + dec(minLa) + '&amp;maxLat=' + dec(maxLa)
            + '&amp;minLng=' + dec(minLo) + '&amp;maxLng=' + dec(maxLo) + '&amp;rows=' + rowsN + '&amp;cols=' + colsN)
}

// 목록 — 화면처럼 {...필터, sort, cursor}, size 없음. 직전 목록에 다음 쪽이 있으면 일부는 그 쪽(같은 조건 + cursor)
if (ep == 'properties-list') {
    def L = props.get('ep_list')
    String base, qs
    if (!skew &amp;&amp; s.listNext != null &amp;&amp; rnd.nextInt(100) &lt; (L.nextPct as int)) {
        base = s.listNext[0]
        qs = (base ? base + '&amp;' : '') + 'cursor=' + enc(s.listNext[1])
    } else {
        def p = []
        if (!skew &amp;&amp; rnd.nextInt(100) &lt; (L.contractPct as int)) p &lt;&lt; 'contractType=' + L.contracts[rnd.nextInt(L.contracts.size())]
        if (!skew &amp;&amp; rnd.nextInt(100) &lt; (L.depositPct as int)) p &lt;&lt; 'depositMax=' + L.deposits[rnd.nextInt(L.deposits.size())]
        if (!skew &amp;&amp; rnd.nextInt(100) &lt; (L.gradePct as int)) L.grades[rnd.nextInt(L.grades.size())].each { p &lt;&lt; 'riskGrade=' + it }
        if (skew || rnd.nextInt(100) &lt; (L.districtPct as int)) p &lt;&lt; 'district=' + enc(row.district)
        if (!skew &amp;&amp; rnd.nextInt(100) &lt; (L.sortPct as int)) p &lt;&lt; 'sort=' + enc(L.sorts[rnd.nextInt(L.sorts.size())])
        base = p.join('&amp;'); qs = base
    }
    vars.put('list_base', base)
    vars.put('list_q', qs ? '?' + qs : '')
}

// 관심 매물 — 짝(wishlist-write)은 표본 하나를 등록 · 해제. 등록만은 계정에 없는 매물, 해제만은 이 시험이 넣은 것 → 목록에서 본 것 → 표본
def all = props.get('ep_rows')
vars.put('wl_id', all[rnd.nextInt(all.size())].property_id)
if (ep == 'wishlist-add') {
    String id = null
    for (int i = 0; i &lt; 5 &amp;&amp; id == null; i++) { def c = all[rnd.nextInt(all.size())].property_id; if (!s.added.contains(c) &amp;&amp; !s.wl.contains(c)) id = c }
    vars.put('wl_add_id', id ?: all[rnd.nextInt(all.size())].property_id)
}
if (ep == 'wishlist-remove') {
    String id
    if (!s.added.isEmpty()) id = s.added.remove(rnd.nextInt(s.added.size()))
    else if (!s.wl.isEmpty()) id = s.wl.remove(rnd.nextInt(s.wl.size()))
    else id = all[rnd.nextInt(all.size())].property_id
    vars.put('wl_rm_id', id)
}

// 프로필 수정 — 두 값을 번갈아(같은 값이면 변경 감지가 UPDATE 를 내지 않아 쓰기를 재지 못한다). 값은 API 명세서(회원) 1.1 예시
if (ep == 'profile-write') { vars.put('annual_income', s.flip ? '42000000' : '45000000'); s.flip = !s.flip }

// 알림 읽음 — 그 계정의 알림 ID 를 처음 한 번 목록(size 100)에서 받는다(준비 요청, 레이블 notifications setup).
// 읽지 않은 것부터 하나씩 읽는다(unread — 실제 UPDATE). 다 읽었으면 읽은 것을 다시(again), 하나도 없으면 none(404)
vars.put('noti_fetch', '0')
if (ep == 'notification-read') {
    if (s.unread == null) {
        vars.put('noti_fetch', '1'); vars.put('noti_mode', 'none'); vars.put('noti_id', '0')
    } else if (!s.unread.isEmpty()) {
        def id = s.unread.remove(rnd.nextInt(s.unread.size())); s.read &lt;&lt; id
        vars.put('noti_mode', 'unread'); vars.put('noti_id', String.valueOf(id))
    } else if (!s.read.isEmpty()) {
        vars.put('noti_mode', 'again'); vars.put('noti_id', String.valueOf(s.read[rnd.nextInt(s.read.size())]))
    } else {
        vars.put('noti_mode', 'none'); vars.put('noti_id', '0')
    }
}
</stringProp></JSR223PreProcessor>
