<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="토큰 시각" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 로그인 뒤 — 받은 시각을 남긴다. 만료(expiresIn 1800초, API 명세서(회원) 1.2) 100초 전에 미리 다시 로그인한다
if (prev.getResponseCode() == '200' &amp;&amp; vars.get('access_token') != 'NOT_FOUND') {
    vars.put('token_at', String.valueOf(System.currentTimeMillis()))
}
vars.put('auth401', '0')
