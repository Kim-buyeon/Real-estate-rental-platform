<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="토큰 시각" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 재발급 뒤 — 새 토큰 두 벌로 갈아 끼운다(회전). 앞의 추출기가 access_token · refresh_token 을 이미 바꿨다. 실패면 NOT_FOUND 라 다음에 로그인한다
if (prev.getResponseCode() == '200' &amp;&amp; vars.get('access_token') != 'NOT_FOUND') {
    vars.put('token_at', String.valueOf(System.currentTimeMillis()))
}
</stringProp></JSR223PostProcessor>
