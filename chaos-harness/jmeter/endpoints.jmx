<hashTree>
<!-- 질의 문자열은 고르기가 만든다 — 화면(fetchPropertyList)처럼 {...필터, sort, cursor}, size 는 보내지 않는다(공통 규약 기본 20) -->
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="properties list" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"></collectionProp></elementProp><stringProp name="HTTPSampler.path">/api/properties${list_q}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp></HTTPSamplerProxy>
<hashTree>
<JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="다음 커서" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">list_next;list_has</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.data.nextCursor;$.data.hasNext</stringProp><stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp><stringProp name="JSONPostProcessor.defaultValues">NONE;false</stringProp></JSONPostProcessor>
<hashTree/>
<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="다음 쪽 기억" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 목록 뒤 — 다음 쪽이 있으면 (같은 조건, 커서)를 계정에 붙여 둔다. 다음 목록 요청이 일부 확률로 그 쪽을 부른다(화면의 무한 스크롤)
def s = vars.getObject('ep_session')
String c = vars.get('list_next')
if (s != null) s.listNext = (prev.getResponseCode() == '200' &amp;&amp; vars.get('list_has') == 'true' &amp;&amp; c &amp;&amp; c != 'NONE' &amp;&amp; c != 'null') ? [vars.get('list_base'), c] : null
</stringProp></JSR223PostProcessor>
